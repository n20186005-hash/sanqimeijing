---
import TopicLayout from '@/components/TopicLayout.astro';
import { bestTime } from '@/data/topics';

// 依往年農期整理的逐月參考（非即時田況）
const monthly = [
  { m: '1 月', note: '休耕或綠肥田為主，適合安靜的田園散步。' },
  { m: '2 月', note: '農村日常景觀，偶有整地作業。' },
  { m: '3 月', note: '春耕開始，水田灌注後可見水面倒影與嫩綠秧苗。' },
  { m: '4 月', note: '新綠稻田生長，中下旬起彩繪稻田圖案逐漸成形。' },
  { m: '5 月', note: '稻穗由翠綠轉為金黃，層次開始豐富。' },
  { m: '6 月', note: '金黃稻浪最佳觀賞期，拍照與散步最推薦。' },
  { m: '7 月', note: '6 月底起陸續收割，田區可能同時出現金黃、收割中與裸田。' },
  { m: '8 月', note: '多為整地或二期作景觀，非金黃稻浪季。' },
  { m: '9 月', note: '農村日常與綠意為主，適合慢遊。' },
  { m: '10 月', note: '進入秋季，田區多以整地、二期作或綠肥景觀為主。' },
  { m: '11 月', note: '休耕與農事準備階段，安靜的冬山田園。' },
  { m: '12 月', note: '冬季農村風景，偶有季節活動，需看當期公告。' },
];

const highlights = [
  { range: '3–4 月', title: '水田與新綠', text: '春耕後秧苗漸長，天晴時可看見水面倒影與清新的淺綠色田野，是較少人擁擠的安靜時段。' },
  { range: '5–6 月', title: '綠金稻浪', text: '稻穗由翠綠轉為金黃，通常也是彩繪稻田最清楚、拍照層次最豐富的時段，最推薦安排在此。' },
  { range: '6 月底–7 月', title: '成熟與收割', text: '同一片田區可能同時出現金黃、收割中與裸田景觀，出發前要先確認田況。' },
  { range: '8–2 月', title: '農村日常', text: '以休耕、整地或其他農作景觀為主，適合慢騎與感受安靜的冬山田園。' },
];
---

<TopicLayout
  slug={bestTime.slug}
  eyebrow={bestTime.eyebrow}
  title={bestTime.title}
  metaTitle={bestTime.metaTitle}
  description={bestTime.description}
  intro={bestTime.intro}
  faqs={bestTime.faqs}
>
  <!-- 逐月田況 -->
  <section>
    <span class="eyebrow">Month by Month</span>
    <h2 class="text-balance mt-5 font-serif text-3xl font-black text-rice-950 sm:text-4xl">三奇美徑逐月田況參考</h2>
    <p class="pretty mt-5 max-w-2xl leading-8 text-rice-800/72">
      下列為依往年農期整理的逐月概略；實際插秧、成熟與收割日期會受品種、天候及農務安排影響，出發前建議再確認當期田況。
    </p>

    <div class="mt-10 overflow-hidden rounded-[2rem] border border-rice-200 bg-white card-shadow">
      <div class="grid grid-cols-1 sm:grid-cols-2">
        {monthly.map((row, i) => (
          <div class:list={["flex items-start gap-4 p-5", i % 2 === 0 ? "sm:border-r" : "", i < monthly.length - 1 && "border-b border-rice-200"]}>
            <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-rice-100 font-serif text-lg font-black text-rice-700">{row.m}</span>
            <p class="text-sm leading-7 text-rice-800/72">{row.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 四大時段重點 -->
  <section class="mt-20">
    <span class="eyebrow">Season Highlights</span>
    <h2 class="text-balance mt-5 font-serif text-3xl font-black text-rice-950 sm:text-4xl">什麼時候去，看到什麼</h2>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {highlights.map((item, index) => (
        <article class:list={["rounded-[2rem] border p-7", index === 1 ? "border-grain-300/50 bg-grain-100" : "border-rice-200 bg-white"]}>
          <p class="font-serif text-2xl font-black text-rice-700">{item.range}</p>
          <h3 class="mt-3 text-xl font-black text-rice-950">{item.title}</h3>
          <p class="mt-3 text-sm leading-7 text-rice-800/66">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- 一天的光線 -->
  <section class="mt-20">
    <span class="eyebrow">Time of Day</span>
    <h2 class="text-balance mt-5 font-serif text-3xl font-black text-rice-950 sm:text-4xl">一天當中什麼時間最好</h2>
    <div class="mt-10 grid gap-5 sm:grid-cols-3">
      <div class="rounded-3xl border border-rice-200 bg-white p-6">
        <p class="font-black text-rice-700">清晨 7–9 點</p>
        <p class="mt-2 text-sm leading-7 text-rice-800/66">溫度較舒適，人潮與逆光較少，適合慢走與拍照。</p>
      </div>
      <div class="rounded-3xl border border-rice-200 bg-white p-6">
        <p class="font-black text-rice-700">日落前 2 小時</p>
        <p class="mt-2 text-sm leading-7 text-rice-800/66">稻穗側光與道路層次通常最好看，是最受推薦的拍攝時段。</p>
      </div>
      <div class="rounded-3xl border border-rice-200 bg-white p-6">
        <p class="font-black text-rice-700">避開正午</p>
        <p class="mt-2 text-sm leading-7 text-rice-800/66">田區遮蔭少，夏季曝曬與體感明顯，正午久留容易中暑。</p>
      </div>
    </div>
  </section>

  <!-- 規劃建議卡 -->
  <section class="mt-20">
    <div class="overflow-hidden rounded-[2.5rem] bg-rice-800 p-8 text-white card-shadow sm:p-12">
      <span class="eyebrow !text-grain-300">Plan Around the Season</span>
      <h2 class="text-balance mt-5 font-serif text-3xl font-black sm:text-4xl">一句話總結</h2>
      <p class="pretty mt-6 max-w-2xl leading-8 text-white/78">
        <strong class="font-black text-grain-300">5 月至 6 月</strong>最值得安排，稻田由翠綠轉為金黃；<strong class="font-black text-grain-300">6 月底至 7 月</strong>陸續進入收割，地景會在短時間內改變。若非稻浪季前來，建議把它當作冬山慢遊的一站，而非專程衝金黃稻田。
      </p>
    </div>
  </section>
</TopicLayout>
