---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { facts, faqs, fieldStatus, nearbyLandmarks, reviews, seasons, site } from '@/data/site';

const touristAttractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${site.url}/#attraction`,
  name: '冬山三奇美徑',
  alternateName: ['三奇美徑', '宜蘭冬山伯朗大道', '宜蘭伯朗大道', '冬山伯朗大道', '三奇稻間美徑'],
  description: site.description,
  url: site.url,
  image: [
    `${site.url}/images/sanqi-green-road.jpg`,
    `${site.url}/images/sanqi-golden-aerial.webp`,
    `${site.url}/images/sanqi-view-platform.webp`,
  ],
  isAccessibleForFree: true,
  publicAccess: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '三奇村三奉路77號附近',
    addressLocality: '冬山鄉',
    addressRegion: '宜蘭縣',
    postalCode: site.postalCode,
    addressCountry: 'TW',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.coordinates.latitude,
    longitude: site.coordinates.longitude,
  },
  hasMap: site.mapsShareUrl,
  sameAs: [site.mapsShareUrl, site.govtTourism.url],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
  touristType: ['攝影旅客', '親子旅客', '自行車旅客', '自然景觀旅客'],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '台灣', item: `${site.url}/#taiwan` },
    { '@type': 'ListItem', position: 2, name: '宜蘭縣', item: `${site.url}/#yilan` },
    { '@type': 'ListItem', position: 3, name: '冬山鄉', item: `${site.url}/#dongshan` },
    { '@type': 'ListItem', position: 4, name: '三奇美徑（宜蘭冬山伯朗大道）', item: `${site.url}/#attraction` },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(touristAttractionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="noise relative isolate min-h-[780px] overflow-hidden bg-rice-950 text-white lg:min-h-[860px]">
    <img
      src="/images/sanqi-green-road.jpg"
      alt="三奇美徑（宜蘭冬山伯朗大道）主視野 — 台灣宜蘭縣冬山鄉翠綠稻田、彩繪稻田與田間道路"
      width="1920"
      height="1279"
      fetchpriority="high"
      class="hero-image absolute inset-0 -z-20 size-full object-cover object-[62%_50%]"
    />
    <div class="hero-mask absolute inset-0 -z-10"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-48 bg-gradient-to-t from-rice-950/65 to-transparent"></div>

    <div class="section-shell flex min-h-[780px] items-center pt-28 pb-36 lg:min-h-[860px]">
      <div class="max-w-3xl">
        <div class="mb-7 flex flex-wrap items-center gap-3 text-xs font-bold tracking-[0.14em]">
          <span class="rounded-full border border-white/25 bg-white/10 px-4 py-2 backdrop-blur-md">宜蘭・冬山</span>
          <span class="rounded-full border border-grain-300/45 bg-grain-300/15 px-4 py-2 text-grain-100 backdrop-blur-md">免費田園景點</span>
        </div>

        <p class="mb-5 font-serif text-lg tracking-[0.28em] text-grain-100 sm:text-xl">走進宜蘭稻田裡的九道 S 彎</p>
        <h1 class="text-balance font-serif text-6xl leading-[0.98] font-black tracking-[0.04em] sm:text-7xl lg:text-[7rem]">
          三奇<br class="sm:hidden" />美徑<span class="sr-only">（宜蘭冬山伯朗大道）</span>
        </h1>
        <p class="mt-6 text-xl font-bold tracking-[0.08em] text-white/86 sm:text-2xl">宜蘭冬山伯朗大道</p>
        <p class="pretty mt-7 max-w-2xl text-base leading-8 text-white/76 sm:text-lg">
          一條約兩公里的田間小路，沿著九道彎曲農路穿過真實稻田。春夏看新綠與金黃，慢慢走、慢慢騎，也把農村日常留在原來的位置。
        </p>

        <div class="mt-7">
          <a
            href={site.mapsShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-ga-event="review_click"
            class="inline-flex flex-wrap items-center gap-x-3 gap-y-2 rounded-full border border-white/25 bg-white/10 px-5 py-3 backdrop-blur-md transition hover:bg-white/20"
          >
            <span class="flex items-center gap-0.5" aria-hidden="true">
              {[0, 1, 2, 3].map(() => (
                <svg viewBox="0 0 24 24" class="size-4 fill-grain-300"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2l-6.1 3.4 1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
              ))}
              <svg viewBox="0 0 24 24" class="size-4 fill-white/35"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2l-6.1 3.4 1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
            </span>
            <span class="font-black text-white">{reviews.ratingLabel}</span>
            <span class="text-sm font-semibold text-white/78">（{reviews.countLabel} 則 Google 地圖評價）</span>
          </a>
          <p class="mt-3 text-xs leading-6 text-white/58">
            評分與評價數同步自谷歌地圖（Google Maps）用戶評價 · {reviews.syncedAt} ·
            <a href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-grain-300 underline decoration-grain-300/40 underline-offset-4 hover:text-white">點擊查看谷歌地圖全部評價↗</a>
          </p>
        </div>

        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#season" class="inline-flex items-center gap-2 rounded-full bg-grain-300 px-6 py-3.5 text-sm font-black text-rice-950 transition hover:-translate-y-0.5 hover:bg-white">
            查看最佳季節
            <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true"><path d="m8 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="#route" class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-6 py-3.5 text-sm font-black text-white backdrop-blur-md transition hover:bg-white/20">
            交通與停車
          </a>
        </div>
      </div>
    </div>

    <div class="absolute inset-x-0 bottom-0">
      <div class="section-shell translate-y-1/2">
        <div class="grid overflow-hidden rounded-[2rem] border border-white/20 bg-white/93 text-rice-950 shadow-2xl backdrop-blur-xl sm:grid-cols-2 lg:grid-cols-4">
          {facts.map((fact, index) => (
            <div class:list={["px-7 py-6", index > 0 && "border-t border-rice-200 sm:border-t-0 sm:border-l"]}>
              <p class="font-serif text-2xl font-black text-rice-800">{fact.value}</p>
              <p class="mt-1 text-sm font-semibold text-rice-700/70">{fact.label}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Status -->
  <section class="pt-32 pb-20 sm:pt-36 sm:pb-28">
    <div class="section-shell">
      <div class="grid items-stretch gap-6 lg:grid-cols-[0.85fr_1.15fr]">
        <div class="overflow-hidden rounded-[2.25rem] bg-rice-800 p-8 text-white card-shadow sm:p-10">
          <div class="flex items-center justify-between gap-4">
            <p class="text-xs font-black tracking-[0.18em] text-grain-300">{fieldStatus.label}</p>
            <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5 text-xs text-white/75">
              <span class="size-2 rounded-full bg-grain-300"></span>
              更新 {fieldStatus.updatedAt}
            </span>
          </div>
          <h2 class="text-balance mt-10 font-serif text-4xl leading-tight font-black sm:text-5xl">{fieldStatus.title}</h2>
          <p class="mt-5 leading-8 text-white/72">{fieldStatus.description}</p>
          <div class="mt-8 border-t border-white/12 pt-5 text-sm font-bold text-grain-100">{fieldStatus.nextBestWindow}</div>
        </div>

        <div class="relative overflow-hidden rounded-[2.25rem] bg-grain-100 p-8 sm:p-10">
          <div class="rice-line absolute inset-0 opacity-70"></div>
          <div class="relative">
            <span class="eyebrow">出發前先知道</span>
            <h2 class="text-balance mt-5 font-serif text-4xl leading-tight font-black text-rice-950 sm:text-5xl">這裡不是全年都金黃</h2>
            <p class="pretty mt-5 max-w-2xl text-base leading-8 text-rice-800/76">
              三奇美徑是農民日常耕作的生產田區，不是固定布景。插秧、成熟與收割會改變整片田野的顏色；最美的畫面，也因此只在合適的農期出現。
            </p>
            <div class="mt-8 grid gap-4 sm:grid-cols-3">
              <div class="rounded-3xl bg-white/68 p-5 backdrop-blur-sm">
                <p class="text-2xl font-black text-rice-700">春</p>
                <p class="mt-2 text-sm leading-6 text-rice-800/70">水田倒影、嫩綠秧苗</p>
              </div>
              <div class="rounded-3xl bg-white/68 p-5 backdrop-blur-sm">
                <p class="text-2xl font-black text-rice-700">夏</p>
                <p class="mt-2 text-sm leading-6 text-rice-800/70">翠綠至金黃稻浪</p>
              </div>
              <div class="rounded-3xl bg-white/68 p-5 backdrop-blur-sm">
                <p class="text-2xl font-black text-rice-700">秋冬</p>
                <p class="mt-2 text-sm leading-6 text-rice-800/70">休耕與農村日常</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="scroll-mt-24 overflow-hidden py-20 sm:py-28">
    <div class="section-shell grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
      <div class="relative min-h-[560px]">
        <figure class="absolute left-0 top-0 w-[78%] overflow-hidden rounded-[2.5rem] card-shadow">
          <img src="/images/sanqi-golden-aerial.webp" alt="從空中俯瞰三奇美徑（宜蘭冬山伯朗大道）金黃色稻田與彎曲農路" width="1920" height="1275" loading="lazy" class="aspect-[4/5] size-full object-cover" />
        </figure>
        <figure class="float-soft absolute bottom-0 right-0 w-[58%] overflow-hidden rounded-[2rem] border-8 border-rice-50 card-shadow">
          <img src="/images/sanqi-view-platform.webp" alt="三奇美徑觀景平台與宜蘭冬山金黃田野" width="1600" height="1068" loading="lazy" class="aspect-[4/3] size-full object-cover" />
        </figure>
        <div class="absolute right-[4%] top-[10%] grid size-28 place-items-center rounded-full bg-grain-300 text-center text-rice-950 shadow-xl sm:size-32">
          <p class="font-serif text-sm font-black leading-6">九道<br /><span class="text-3xl">S</span> 彎</p>
        </div>
      </div>

      <div>
        <span class="eyebrow">Sanqi Scenic Path</span>
        <h2 class="text-balance mt-5 font-serif text-4xl leading-tight font-black text-rice-950 sm:text-6xl">不是仿造的景點，<br />而是仍在耕作的風景</h2>
        <p class="pretty mt-7 text-base leading-8 text-rice-800/76">
          歡迎來到三奇美徑（SanqiMeijing），即旅人廣為人知的宜蘭冬山伯朗大道。位於台灣宜蘭縣冬山鄉三奇村，介於奉尊宮與協松路之間；約五米寬的農路，在大片平坦稻田裡連續轉出九個 S 形彎道，視線少有高樓與電線桿阻擋，形成宜蘭少見的遼闊田野景觀，也是造訪宜蘭旅客的核心目的地之一。
        </p>
        <p class="pretty mt-5 text-base leading-8 text-rice-800/76">
          造訪三奇美徑時，旅人也能順道探索周邊地標與景點，包括{nearbyLandmarks.map((landmark) => landmark.name).join('與')}。請留在道路與開放區域，不走入稻田、不踩田埂，也不打擾農機作業。
        </p>
        <p class="pretty mt-5 text-base leading-8 text-rice-800/76">
          這裡被旅人暱稱為「宜蘭伯朗大道」，但真正值得感受的，是騎過稻香、遠山與農忙節奏的冬山日常。
        </p>

        <nav aria-label="地理位置層級" class="mt-8 flex flex-wrap items-center gap-2 text-sm font-bold text-rice-700/75">
          <span>三奇美徑</span>
          <svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>冬山鄉</span>
          <svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>宜蘭縣</span>
          <svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>台灣</span>
        </nav>

        <h3 class="mt-10 text-xs font-black tracking-[0.18em] text-rice-600">順道探索周邊地標</h3>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2">
          {nearbyLandmarks.map((landmark) => (
            <li class="rounded-3xl border border-rice-200 bg-white/72 p-5">
              <p class="font-black text-rice-950">{landmark.name}</p>
              <p class="mt-2 text-sm leading-7 text-rice-800/70">{landmark.description}</p>
            </li>
          ))}
        </ul>

        <dl class="mt-9 grid grid-cols-2 gap-x-6 gap-y-6 border-t border-rice-200 pt-8">
          <div>
            <dt class="text-xs font-black tracking-[0.12em] text-rice-600">位置</dt>
            <dd class="mt-2 font-bold text-rice-950">冬山鄉三奇村</dd>
          </div>
          <div>
            <dt class="text-xs font-black tracking-[0.12em] text-rice-600">入口建議</dt>
            <dd class="mt-2 font-bold text-rice-950">三奇奉尊宮</dd>
          </div>
          <div>
            <dt class="text-xs font-black tracking-[0.12em] text-rice-600">玩法</dt>
            <dd class="mt-2 font-bold text-rice-950">步行・單車・攝影</dd>
          </div>
          <div>
            <dt class="text-xs font-black tracking-[0.12em] text-rice-600">最佳光線</dt>
            <dd class="mt-2 font-bold text-rice-950">清晨或日落前</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Season -->
  <section id="season" class="scroll-mt-20 bg-rice-950 py-24 text-white sm:py-32">
    <div class="section-shell">
      <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
        <div>
          <span class="eyebrow !text-grain-300">Rice Calendar</span>
          <h2 class="text-balance mt-5 font-serif text-4xl leading-tight font-black sm:text-6xl">跟著稻田的時間來</h2>
          <p class="pretty mt-6 max-w-md leading-8 text-white/62">
            網路上最常見的翠綠與金黃畫面，多集中在春末至初夏。安排前先理解農期，比單看月份更可靠。
          </p>
          <p class="pretty mt-5 max-w-md rounded-3xl border border-white/12 bg-white/[0.05] p-5 leading-8 text-white/78">
            一句話：<strong class="font-black text-grain-300">5 月至 6 月</strong>最值得安排，稻田由翠綠轉為金黃；<strong class="font-black text-grain-300">6 月底至 7 月</strong>陸續進入收割，地景會在短時間內改變。
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {seasons.map((season, index) => (
            <article class:list={["group rounded-[2rem] border p-7 transition hover:-translate-y-1", index === 1 ? "border-grain-300/45 bg-grain-300/12" : "border-white/10 bg-white/[0.045]"]}>
              <div class="flex items-start justify-between gap-4">
                <p class="font-serif text-3xl font-black text-grain-300">{season.months}</p>
                <span class:list={["rounded-full px-3 py-1 text-[11px] font-black tracking-[0.12em]", index === 1 ? "bg-grain-300 text-rice-950" : "bg-white/10 text-white/70"]}>{season.level}</span>
              </div>
              <h3 class="mt-7 text-xl font-black">{season.title}</h3>
              <p class="mt-3 text-sm leading-7 text-white/58">{season.description}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="mt-14 rounded-[2rem] border border-white/10 bg-white/[0.04] p-6 sm:p-8">
        <div class="grid gap-5 sm:grid-cols-3">
          <div class="flex gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-white/8 text-grain-300">
              <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true"><path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
            </span>
            <div><p class="font-bold">早上 7–9 點</p><p class="mt-1 text-sm leading-6 text-white/50">溫度較舒適，人潮與逆光較少。</p></div>
          </div>
          <div class="flex gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-white/8 text-grain-300">
              <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true"><path d="M4 18h16M6 14h12M8 10h8M12 3v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </span>
            <div><p class="font-bold">日落前 2 小時</p><p class="mt-1 text-sm leading-6 text-white/50">稻穗側光與道路層次通常最好看。</p></div>
          </div>
          <div class="flex gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-white/8 text-grain-300">
              <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true"><path d="M12 3 4 8v8l8 5 8-5V8l-8-5Z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m4 8 8 5 8-5M12 13v8" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
            </span>
            <div><p class="font-bold">避開正午</p><p class="mt-1 text-sm leading-6 text-white/50">田區遮蔭少，夏季曝曬與體感明顯。</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo spots -->
  <section class="py-24 sm:py-32">
    <div class="section-shell">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <span class="eyebrow">Photo Notes</span>
          <h2 class="text-balance mt-5 font-serif text-4xl leading-tight font-black text-rice-950 sm:text-6xl">三種看見田野的角度</h2>
        </div>
        <p class="max-w-md text-sm leading-7 text-rice-800/65">拍照時留在道路邊緣，遇到農機與居民通行請主動避讓；空拍須遵守當地與航空相關規定。</p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        <article class="group overflow-hidden rounded-[2.1rem] bg-white card-shadow">
          <div class="overflow-hidden"><img src="/images/sanqi-green-road.jpg" alt="從較高視角拍攝三奇美徑田間道路" width="1920" height="1279" loading="lazy" class="aspect-[4/3] size-full object-cover transition duration-700 group-hover:scale-105" /></div>
          <div class="p-7"><p class="text-xs font-black tracking-[0.14em] text-rice-600">01・高處全景</p><h3 class="mt-3 text-2xl font-black">看見道路穿過稻海</h3><p class="mt-3 text-sm leading-7 text-rice-800/66">較高視角最能呈現 S 彎、彩繪稻田與遠山。觀景設施依年度與活動安排開放。</p></div>
        </article>
        <article class="group overflow-hidden rounded-[2.1rem] bg-white card-shadow">
          <div class="overflow-hidden"><img src="/images/sanqi-view-platform.webp" alt="三奇美徑觀景平台眺望金黃稻田" width="1600" height="1068" loading="lazy" class="aspect-[4/3] size-full object-cover transition duration-700 group-hover:scale-105" /></div>
