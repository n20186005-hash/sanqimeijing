---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { nearbyPlaces, nearbyMap } from '@/data/nearby';
import { nearbyDetails } from '@/data/nearbyDetails';
import { site } from '@/data/site';
export function getStaticPaths() { return nearbyPlaces.map((place) => ({ params: { slug: place.slug }, props: { place } })); }
const { place } = Astro.props;
const detail = nearbyDetails[place.slug];
const mapUrl = nearbyMap(place);
const relatedPlaces = nearbyPlaces.filter((candidate) => candidate.slug !== place.slug).slice(0, 4);
const canonical = `${site.url}/nearby/${place.slug}/`;
const schema = { '@context': 'https://schema.org', '@type': 'TouristAttraction', name: place.name, description: place.summary, url: canonical, address: { '@type': 'PostalAddress', streetAddress: place.address, addressCountry: 'TW' }, hasMap: mapUrl, isAccessibleForFree: place.admission.includes('免費') ? true : undefined };
const breadcrumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: '首頁', item: `${site.url}/` }, { '@type': 'ListItem', position: 2, name: '周邊探索', item: `${site.url}/nearby/` }, { '@type': 'ListItem', position: 3, name: place.name, item: canonical }] };
---
<BaseLayout title={`${place.name}｜歷史、特色、交通、門票與三奇美徑順遊指南`} description={`${place.name}景點介紹：${place.summary}整理地址、開放與門票、參觀路線、拍照機位、交通及常見問題。`}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  <section class="relative isolate overflow-hidden bg-rice-950 pb-20 pt-40 text-white sm:pt-48">
    <img src={`/images/nearby/${place.slug}.jpg`} alt={`${place.name}景點實景`} width="1920" height="1080" fetchpriority="high" class="absolute inset-0 -z-20 size-full object-cover opacity-25" />
    <div class="section-shell">
      <nav class="text-sm text-white/65"><a href="/" class="hover:text-white">首頁</a> / <a href="/nearby/" class="hover:text-white">周邊探索</a> / {place.name}</nav>
      <p class="mt-10 text-sm font-black tracking-widest text-grain-300">{place.type} · 宜蘭順遊</p>
      <h1 class="mt-5 font-serif text-5xl font-black leading-tight sm:text-7xl">{place.name}</h1>
      <p class="mt-4 text-xl font-bold text-grain-100">{place.subtitle}</p>
      <p class="mt-7 max-w-3xl text-lg leading-9 text-white/75">{place.summary}</p>
      <div class="mt-8 flex flex-wrap gap-3 text-sm"><span class="rounded-full border border-white/30 px-5 py-3">{place.stay}</span><span class="rounded-full border border-white/30 px-5 py-3">{place.hours}</span><span class="rounded-full border border-white/30 px-5 py-3">評價：請查閱 Google 地圖最新紀錄</span><a href={mapUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-grain-300 px-6 py-3 font-black text-rice-950">此景點 Google 地圖 ↗</a></div>
    </div>
  </section>
  <!-- 第二屏：以景點本身的管理主體與歷史脈絡介紹，不置入網站編輯備註 -->
  <section class="border-b border-rice-200 bg-grain-100 py-20 sm:py-24" id="about-place">
    <div class="section-shell grid items-start gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div><span class="eyebrow">About the Place</span><h2 class="mt-5 font-serif text-4xl font-black leading-tight text-rice-950 sm:text-5xl">關於{place.name}</h2><p class="mt-6 text-sm font-bold leading-7 text-rice-700">管理與維護：{detail.manager}</p><a href={detail.managementSource} target="_blank" rel="noopener noreferrer" class="mt-5 inline-block text-sm font-black text-rice-700 underline underline-offset-4">管理及景點資料來源 ↗</a></div>
      <div class="space-y-5 text-base leading-9 text-rice-800/85"><p>{detail.about}</p><p>{detail.character}</p><p class="font-semibold text-rice-800">今日可依開放範圍欣賞景觀、了解在地生活，行前請核對各設施與活動的最新公告。</p></div>
    </div>
  </section>
  <figure class="section-shell mt-12"><img src={`/images/nearby/${place.slug}.jpg`} alt={`${place.name}的實景照片`} width="1920" height="1080" class="max-h-[540px] w-full rounded-[2rem] object-cover" /><figcaption class="mt-3 text-xs text-rice-700/65">{place.name} · 實景照片資料：<a href={place.source} target="_blank" rel="noopener noreferrer" class="underline">景點資料來源 ↗</a></figcaption></figure>
  <div class="section-shell grid gap-12 py-20 lg:grid-cols-[1.5fr_0.8fr] sm:py-28">
    <article class="space-y-14 text-rice-800">
      <section><p class="eyebrow">Explore</p><h2 class="mt-4 font-serif text-4xl font-black text-rice-950">探索{place.name}</h2><p class="mt-5 leading-9">{place.summary} {place.subtitle}。依照季節、天氣與旅伴體力，可以把這一站安排為三奇美徑周邊旅程的一部分；各項體驗與開放情況應以當日現場為準。</p></section>
      <section><p class="eyebrow">Essential Information</p><h2 class="mt-4 font-serif text-4xl font-black text-rice-950">景點基本資訊</h2><dl class="mt-6 grid gap-3 sm:grid-cols-2">{[['景點名稱',place.name],['景點類型',place.type],['詳細地點',place.address],['建議停留',place.stay]].map(([label,value]) => <div class="rounded-2xl bg-grain-100 p-5"><dt class="text-sm font-black text-rice-700">{label}</dt><dd class="mt-2 leading-8">{value}</dd></div>)}</dl></section>
      <section><p class="eyebrow">Hours & Tickets</p><h2 class="mt-4 font-serif text-4xl font-black text-rice-950">開放時間與門票價格</h2><div class="mt-6 grid gap-5 sm:grid-cols-2"><div class="rounded-2xl border border-rice-200 p-6"><h3 class="text-xl font-black">開放時間</h3><p class="mt-4 leading-8">{place.hours}</p></div><div class="rounded-2xl border border-rice-200 p-6"><h3 class="text-xl font-black">門票與費用</h3><p class="mt-4 leading-8">{place.admission}</p></div></div><p class="mt-4 text-sm leading-7">節慶活動、導覽、交通接駁與個別服務可能另有時間或收費規定，出發前請<a href={place.source} target="_blank" rel="noopener noreferrer" class="underline">參照景點公告</a>。</p></section>
      <section><p class="eyebrow">Getting Here</p><h2 class="mt-4 font-serif text-4xl font-black text-rice-950">交通方式與步行動線</h2><p class="mt-5 leading-9">{place.transport}</p><p class="mt-4 leading-9">騎車或開車請先確認目的地是本景點的入口或可停車處，避免把三奇美徑的定位當成所有景點的共同導航點。</p><a href={mapUrl} class="mt-5 inline-flex rounded-full bg-rice-800 px-6 py-3 font-bold text-white" target="_blank" rel="noopener noreferrer">導航至{place.name} ↗</a></section>
      <section><p class="eyebrow">認識景點</p><h2 class="mt-4 font-serif text-4xl font-black text-rice-950">歷史與地方背景</h2><p class="mt-5 leading-9">{place.history}</p></section>
      <section><p class="eyebrow">Discover the Place</p><h2 class="mt-4 font-serif text-4xl font-black text-rice-950">發現魅力：建築、文化與核心體驗</h2><p class="mt-5 leading-9">{detail.character}</p><p class="mt-4 leading-9">{detail.culture}</p></section>
      <section><p class="eyebrow">Visit Suggestions</p><h2 class="mt-4 font-serif text-4xl font-black text-rice-950">遊覽建議與核心體驗</h2><p class="mt-5 leading-9">{detail.visit}</p><p class="mt-5 leading-9">{detail.culture}</p></section>
      <section><p class="eyebrow">Highlights</p><h2 class="mt-4 font-serif text-4xl font-black text-rice-950">建築、環境與觀察重點</h2><ul class="mt-6 space-y-4">{place.highlights.map((item) => <li class="rounded-2xl bg-rice-100 p-5 leading-8">{item}</li>)}</ul></section>
      <section><p class="eyebrow">Walking Route</p><h2 class="mt-4 font-serif text-4xl font-black text-rice-950">建議參觀路線</h2><ol class="mt-6 space-y-5">{place.route.map((step, index) => <li class="flex gap-5"><span class="grid size-10 shrink-0 place-items-center rounded-full bg-rice-800 font-black text-white">{index + 1}</span><p class="pt-1 leading-8">{step}</p></li>)}</ol></section>
      <section><p class="eyebrow">Photo Spots</p><h2 class="mt-4 font-serif text-4xl font-black text-rice-950">拍攝機位與時間</h2><p class="mt-5 leading-9">{place.photos}</p></section>
      <section><p class="eyebrow">Travel Tips</p><h2 class="mt-4 font-serif text-4xl font-black text-rice-950">游覽須知與親子提醒</h2><ul class="mt-5 list-disc space-y-3 pl-6 leading-8">{place.tips.map((tip) => <li>{tip}</li>)}</ul></section>
      <section><p class="eyebrow">Accommodation</p><h2 class="mt-4 font-serif text-4xl font-black text-rice-950">住宿建議與行程銜接</h2><p class="mt-5 leading-9">預計隔天繼續遊覽冬山與三奇稻田，可優先考慮冬山車站、羅東車站周邊住宿，便於火車與公車轉乘；若自駕安排蘇澳及五結景點，也可按隔日目的地選擇落腳區域。入住前請自行查詢停車、接駁及退房安排。</p><p class="mt-4 leading-8">此站建議停留：{place.stay}。可串聯<a class="font-black underline" href="/nearby/">更多周邊景點</a>，依交通時間決定半日或一日路線。</p></section>
      <section><p class="eyebrow">FAQ</p><h2 class="mt-4 font-serif text-4xl font-black text-rice-950">常見問題</h2><div class="mt-5 divide-y divide-rice-200 border-y border-rice-200">{place.faqs.map((faq) => <div class="py-5"><h3 class="text-lg font-black">{faq.question}</h3><p class="mt-2 leading-8">{faq.answer}</p></div>)}</div></section>
      <section><p class="eyebrow">Visitor Reviews</p><h2 class="mt-4 font-serif text-4xl font-black text-rice-950">遊客評價與最新現況</h2><p class="mt-5 leading-9">這處景點的最新照片、訪客觀察與評價可從其獨立 Google 地圖頁查看。景點體驗受活動、天候與維護安排影響，出發前可比對近期遊客資訊。</p><a href={mapUrl} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex rounded-full bg-rice-800 px-6 py-3 text-sm font-bold text-white">查看{place.name}的 Google 地圖 ↗</a></section>
      <section><p class="eyebrow">Map & Address</p><h2 class="mt-4 font-serif text-4xl font-black text-rice-950">交通指南與 Google 地圖</h2><p class="mt-5 leading-9"><strong>目的地：</strong>{place.name}<br /><strong>地址／地點：</strong>{place.address}</p><p class="mt-4 leading-8">{place.transport}</p><a href={mapUrl} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex rounded-full bg-rice-800 px-6 py-3 font-bold text-white">在 Google 地圖搜尋{place.name} ↗</a></section>
    </article>
    <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
      <div class="rounded-[2rem] bg-grain-100 p-7"><h2 class="font-serif text-2xl font-black text-rice-950">基本資訊</h2><dl class="mt-5 divide-y divide-rice-300 text-sm leading-7"><div class="py-3"><dt class="font-black">地址</dt><dd>{place.address}</dd></div><div class="py-3"><dt class="font-black">開放時間</dt><dd>{place.hours}</dd></div><div class="py-3"><dt class="font-black">門票價格</dt><dd>{place.admission}</dd></div><div class="py-3"><dt class="font-black">建議停留</dt><dd>{place.stay}</dd></div></dl><a class="mt-5 inline-block rounded-full bg-rice-800 px-6 py-3 text-sm font-bold text-white" href={mapUrl} target="_blank" rel="noopener noreferrer">開啟此景點導航 ↗</a></div>
      <div class="rounded-[2rem] border border-rice-200 bg-white p-7"><h2 class="font-serif text-2xl font-black text-rice-950">如何抵達</h2><p class="mt-4 text-sm leading-8">{place.transport}</p><p class="mt-4 text-sm leading-7">住宿可優先比較冬山車站周邊或羅東交通節點，依隔日行程與交通方式選擇。</p></div>
      <div class="rounded-[2rem] border border-rice-200 bg-white p-7"><h2 class="font-serif text-2xl font-black text-rice-950">資料來源</h2><p class="mt-3 text-sm leading-7">景點事實與開放資訊參照公開的官方介紹；最新時刻與費用請依現場公告。導航提供景點名稱及地理位置的專屬 Google 地圖搜尋。</p><a class="mt-3 inline-block text-sm font-bold underline" href={place.source} target="_blank" rel="noopener noreferrer">景點資料 ↗</a><p class="mt-3 text-xs text-rice-700/65">內容整理：2026 年 11 月。</p></div>
    </aside>
  </div>
  <section class="bg-rice-100 py-16"><div class="section-shell"><h2 class="font-serif text-3xl font-black text-rice-950">接著探索冬山</h2><p class="mt-4 max-w-3xl leading-8 text-rice-800/75">若想把{place.name}安排進半日或一日行程，也可以比較以下不同主題的周邊景點；每篇都有各自的開放資訊、交通與 Google 地圖導航。</p><div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{relatedPlaces.map((related) => <a href={`/nearby/${related.slug}/`} class="group overflow-hidden rounded-2xl bg-white"><img src={`/images/nearby/${related.slug}.jpg`} width="640" height="400" loading="lazy" alt={`${related.name}實景`} class="aspect-[16/10] w-full object-cover" /><div class="p-5"><p class="text-xs font-bold text-rice-600">{related.type}</p><h3 class="mt-2 text-xl font-black group-hover:text-rice-600">{related.name}</h3><p class="mt-2 text-sm leading-6 text-rice-800/70">{related.subtitle}</p></div></a>)}</div><div class="mt-8 flex flex-wrap gap-3"><a href="/" class="rounded-full bg-white px-5 py-3 font-bold">三奇美徑首頁</a><a href="/nearby/" class="rounded-full bg-white px-5 py-3 font-bold">所有周邊景點</a><a href="/best-time/" class="rounded-full bg-white px-5 py-3 font-bold">稻田季節</a><a href="/transportation/" class="rounded-full bg-white px-5 py-3 font-bold">交通停車</a></div></div></section>
</BaseLayout>
