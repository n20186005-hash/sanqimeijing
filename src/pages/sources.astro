---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { fieldStatus, reviews, site } from '@/data/site';
---

<BaseLayout title={`資料來源與更新說明｜${site.name}`} description="三奇美徑旅遊指南的 Google 地圖評價、實景影像、稻作農期及地圖資訊來源與同步時間。">
  <section class="bg-rice-950 pb-16 pt-36 text-white sm:pt-44">
    <div class="section-shell max-w-5xl">
      <span class="text-xs font-black tracking-[0.18em] text-grain-300">SOURCES & UPDATES</span>
      <h1 class="mt-5 font-serif text-5xl font-black sm:text-7xl">資料來源與更新說明</h1>
      <p class="mt-6 max-w-3xl text-base leading-8 text-white/70">本站依公開資訊整理旅遊資料，以下列出來源及同步時間，方便旅人查核與延伸閱讀。</p>
    </div>
  </section>
  <article class="section-shell max-w-5xl py-16 sm:py-24">
    <dl class="grid gap-6 md:grid-cols-2">
      <div class="rounded-[2rem] border border-rice-200 bg-rice-100 p-7 sm:p-9">
        <dt class="text-sm font-black tracking-wide text-rice-950">評價 · 同步時間 {reviews.syncedAt}</dt>
        <dd class="mt-4 text-sm leading-8 text-rice-800/75">評分與評價數同步自 Google 地圖用戶評價，同步時間 {reviews.syncedAt}；版權歸原作者與 Google 地圖所有。評價僅於頁面展示，未納入結構化資料。</dd>
        <dd class="mt-5"><a href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-rice-950 underline underline-offset-4">在 Google 地圖查看全部評價 ↗</a></dd>
      </div>
      <div class="rounded-[2rem] border border-rice-200 bg-rice-100 p-7 sm:p-9">
        <dt class="text-sm font-black tracking-wide text-rice-950">實景影像</dt>
        <dd class="mt-4 text-sm leading-8 text-rice-800/75">網站實景影像以宜蘭縣政府「宜蘭勁好玩」與冬山鄉公所公開旅遊圖片為主要來源。已刊載的照片保留在相應景點頁面。</dd>
        <dd class="mt-5"><a href={site.govtTourism.url} target="_blank" rel="noopener noreferrer" class="font-bold text-rice-950 underline underline-offset-4">{site.govtTourism.name} ↗</a></dd>
      </div>
      <div class="rounded-[2rem] border border-rice-200 bg-rice-100 p-7 sm:p-9">
        <dt class="text-sm font-black tracking-wide text-rice-950">田況與農期</dt>
        <dd class="mt-4 text-sm leading-8 text-rice-800/75">稻作季節與田況說明依往年農期與當季活動時程整理，資料更新日期為 {fieldStatus.updatedAt}。實際稻田景觀、收割及農務安排以現場為準。</dd>
      </div>
      <div class="rounded-[2rem] border border-rice-200 bg-rice-100 p-7 sm:p-9">
        <dt class="text-sm font-black tracking-wide text-rice-950">位置與地圖</dt>
        <dd class="mt-4 text-sm leading-8 text-rice-800/75">地址：{site.fullAddress}。地圖、評價與導航資訊以 Google 地圖目前顯示為準，可前往地圖檢視最新內容。</dd>
        <dd class="mt-5"><a href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-rice-950 underline underline-offset-4">開啟 Google 地圖 ↗</a></dd>
      </div>
    </dl>
    <div class="mt-10 flex flex-wrap gap-4 text-sm font-bold"><a class="rounded-full bg-rice-950 px-6 py-3 text-white" href="/">返回首頁</a><a class="rounded-full border border-rice-300 px-6 py-3 text-rice-950" href="/nearby/">探索周邊景點</a></div>
  </article>
</BaseLayout>
