---
import { site } from '@/data/site';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-rice-950/70 text-white backdrop-blur-xl">
  <div class="section-shell flex h-18 items-center justify-between gap-5">
    <a href="/" class="group flex items-center gap-3" aria-label={`${site.name}首頁`}>
      <span class="grid size-10 place-items-center rounded-full border border-white/25 bg-white/10 transition group-hover:bg-white/20">
        <svg viewBox="0 0 36 36" class="size-6" aria-hidden="true">
          <path d="M5 29c7-1 9-8 12-14 2-5 6-8 14-8-1 7-5 12-10 15-5 2-9 5-11 9" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
          <path d="M10 27c5-1 8 0 12 4" fill="none" stroke="#e8ca79" stroke-width="2" stroke-linecap="round" />
        </svg>
      </span>
      <span>
        <span class="block font-serif text-lg font-bold tracking-[0.15em]">三奇美徑</span>
        <span class="hidden text-[10px] tracking-[0.2em] text-white/65 sm:block">SANQI MEIJING</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 text-sm font-semibold lg:flex" aria-label="主要導覽">
      <a class="transition hover:text-grain-300" href="#about">認識美徑</a>
      <a class="transition hover:text-grain-300" href="#season">最佳季節</a>
      <a class="transition hover:text-grain-300" href="#route">交通路線</a>
      <a class="transition hover:text-grain-300" href="#gallery">田野影像</a>
      <a class="transition hover:text-grain-300" href="#reviews">旅人評價</a>
      <a class="transition hover:text-grain-300" href="#faq">常見問題</a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={site.mapUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-2 rounded-full bg-grain-300 px-5 py-2.5 text-sm font-extrabold text-rice-950 transition hover:-translate-y-0.5 hover:bg-white sm:inline-flex"
        data-ga-event="map_click"
      >
        <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z"/></svg>
        開啟導航
      </a>

      <details class="relative lg:hidden">
        <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-full border border-white/25 bg-white/10" aria-label="開啟選單">
          <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </summary>
        <div class="absolute right-0 mt-3 w-64 overflow-hidden rounded-3xl border border-white/15 bg-rice-950/95 p-3 shadow-2xl backdrop-blur-xl">
          <nav class="grid text-sm font-bold" aria-label="行動版導覽">
            <a class="rounded-2xl px-4 py-3 hover:bg-white/10" href="#about">認識美徑</a>
            <a class="rounded-2xl px-4 py-3 hover:bg-white/10" href="#season">最佳季節</a>
            <a class="rounded-2xl px-4 py-3 hover:bg-white/10" href="#route">交通路線</a>
            <a class="rounded-2xl px-4 py-3 hover:bg-white/10" href="#gallery">田野影像</a>
            <a class="rounded-2xl px-4 py-3 hover:bg-white/10" href="#reviews">旅人評價</a>
            <a class="rounded-2xl px-4 py-3 hover:bg-white/10" href="#faq">常見問題</a>
            <a class="mt-2 rounded-2xl bg-grain-300 px-4 py-3 text-center text-rice-950" href={site.mapUrl} target="_blank" rel="noopener noreferrer">開啟導航</a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
